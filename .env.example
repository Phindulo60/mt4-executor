# MetaApi.cloud API token (Dashboard -> API access token)
METAAPI_TOKEN=

# --- One-flag demo/live switch ------------------------------------------------
# Set MT_MODE to `demo` or `live`. When set, the broker credentials below are
# read from the MODE-prefixed vars (DEMO_* / LIVE_*), so a single .env can hold
# both sets and you flip between them with one flag. Leave MT_MODE empty to use
# the bare MT_LOGIN / MT_PASSWORD / MT_SERVER vars instead (legacy behaviour).
#
# The deploy provisioner mirrors this: `setup.py --mode demo|live` writes the
# selected credentials into the AWS secret and bounces the running engine.
MT_MODE=demo

# Broker account login (number). *_MT_SERVER is the .srv name MetaApi expects
# (a plain hyphen, no spaces, e.g. "ICMarkets-Demo"), NOT the terminal label.
DEMO_MT_LOGIN=
DEMO_MT_PASSWORD=
DEMO_MT_SERVER=

LIVE_MT_LOGIN=
LIVE_MT_PASSWORD=
LIVE_MT_SERVER=

# Legacy / mode-agnostic fallbacks (used only when MT_MODE is empty, or when a
# DEMO_*/LIVE_* var above is missing):
MT_LOGIN=
MT_PASSWORD=
MT_SERVER=

# Optional overrides
MT_ACCOUNT_NAME=mt4-executor
MT_MAGIC=1000
# METAAPI_REGION=new-york

# --- Control plane (only needed for the `engine` command / site integration) ---
# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Supabase SERVICE-ROLE key (server-side only - never ship to the browser)
SUPABASE_SERVICE_KEY=
# Identifies this bot instance in the shared tables
BOT_ID=default

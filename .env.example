# MetaApi.cloud API token (Dashboard -> API access token)
METAAPI_TOKEN=

# Your MT4 broker account login (number)
MT_LOGIN=

# Your MT4 broker account password (master, not investor — investor is read-only)
MT_PASSWORD=

# Broker MT4 server name as MetaApi expects it (the .srv name, NOT the pretty
# label in the terminal). Use a plain hyphen and no spaces, e.g. "ICMarkets-Demo".
# If provisioning fails, MetaApi's error suggests the correct name(s).
MT_SERVER=

# Optional overrides
MT_ACCOUNT_NAME=mt4-executor
MT_MAGIC=1000
# METAAPI_REGION=new-york

# --- Control plane (only needed for the `engine` command / site integration) ---
# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Supabase SERVICE-ROLE key (server-side only - never ship to the browser)
SUPABASE_SERVICE_KEY=
# Identifies this bot instance in the shared tables
BOT_ID=default

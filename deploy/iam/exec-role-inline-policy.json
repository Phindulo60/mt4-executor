{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEngineSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:mt4-executor/engine-*"
    },
    {
      "Sid": "WriteEngineLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/ecs/mt4-executor-engine:*"
    }
  ]
}
